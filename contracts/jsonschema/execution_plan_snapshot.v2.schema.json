{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/contracts/jsonschema/execution_plan_snapshot/v2",
  "title": "ExecutionPlanSnapshot v2（蓝图 §10.5.1 单机子集：不可变签名执行计划）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": "2" },
    "workloadIdentity": { "const": "pi.orchestrator" },
    "executionPlanSnapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "确定性 ID（sha256 前缀）"
    },
    "taskId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "taskSpecDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "可选：task_spec v2 的 payloadDigest（无 spec 时省略，走 optionalImmutablePointers）"
    },
    "compilerId": { "const": "pi-orchestrator" },
    "compilerVersion": { "type": "string", "minLength": 1 },
    "planKind": { "type": "string", "enum": ["INITIAL"] },
    "plannedAttemptInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plannedAttemptInputId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
          "workflowNodeId": { "type": "string", "pattern": "^step-[0-9]+$" },
          "runKind": { "type": "string", "enum": ["IMPLEMENTATION", "REVIEW", "READ_ONLY"] },
          "deliverableKind": { "type": "string", "enum": ["CODE_CHANGE", "REVIEW_EVIDENCE", "READ_ONLY_EVIDENCE"] },
          "promptContent": { "type": "string", "description": "本步对 agent 的指令（子集：直接内联 prompt，不引 prompt bundle）" },
          "upstreamBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slotId": { "type": "string", "minLength": 1 },
                "producerNodeId": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
              },
              "required": ["slotId", "producerNodeId", "required"]
            }
          }
        },
        "required": ["plannedAttemptInputId", "workflowNodeId", "runKind", "deliverableKind"]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "canonicalPlannedInputsDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256(JCS(plannedAttemptInputs 集合归一化排序))——不可变广播摘要"
    },
    "parentExecutionPlanSnapshotId": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{32}$",
      "description": "INITIAL 必须为 null；REPAIR 指向父计划（REPAIR 为保留名，子集不签发）"
    },
    "compiledBy": { "type": "string", "minLength": 1 },
    "compiledAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "payloadDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "description": "self-digest：本快照 canonicalPayload 的 sha256" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectType": { "const": "execution_plan_snapshot" },
        "schemaVersion": { "const": "2" },
        "signatureAlgorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "issuerWorkloadIdentity": { "const": "pi.orchestrator" },
        "audience": { "type": "string" },
        "controlPlaneEpoch": { "type": "integer", "minimum": 0 },
        "signedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "payloadDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      },
      "required": [
        "objectType", "schemaVersion", "signatureAlgorithm", "keyId",
        "issuer", "issuerWorkloadIdentity", "audience", "controlPlaneEpoch",
        "signedAt", "payloadDigest", "value"
      ]
    }
  },
  "required": [
    "contractVersion", "workloadIdentity", "executionPlanSnapshotId", "taskId",
    "compilerId", "compilerVersion", "planKind", "plannedAttemptInputs",
    "canonicalPlannedInputsDigest", "parentExecutionPlanSnapshotId",
    "compiledBy", "compiledAt", "payloadDigest"
  ]
}